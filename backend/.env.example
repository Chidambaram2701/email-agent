# ==============================================================================
# Enterprise AI Email Intelligence Agent - Environment Variables Template
# Copy this file to '.env' and adjust the variables for your setup.
# ==============================================================================

# Application Settings
APP_NAME="Email Intelligence Agent"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# AI Mode Configuration
# Options: "FALLBACK" (Rule-based heuristics, lightweight, runs instantly without RAM constraints)
#          "PRODUCTION" (Downloads & runs Hugging Face models locally: bart-large-mnli, flan-t5, bart-large-cnn)
AI_MODE="FALLBACK"

# AWS Configuration (Leave blank for auto-fallback to local JSON database mode)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"
DYNAMODB_ENDPOINT_URL=""  # Use http://localhost:8000 for local DynamoDB Local, leave blank for live AWS
EMAILS_TABLE_NAME="emails"
TASKS_TABLE_NAME="tasks"
ANALYTICS_TABLE_NAME="analytics"

# IMAP Configuration (For Outlook or other email clients)
# For Outlook IMAP server is "outlook.office365.com" and port is 993
IMAP_SERVER="outlook.office365.com"
IMAP_PORT=993
IMAP_EMAIL=""
IMAP_PASSWORD="" # Outlook requires an App Password if Multi-Factor Authentication is enabled

# Demo / Simulation Mode
# If set to true, fetching will always generate synthetic incoming emails instead of connecting to a real IMAP server.
DEMO_MODE=true
